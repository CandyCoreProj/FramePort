{
  "name": "frameport",
  "productName": "FramePort",
  "version": "1.0.7",
  "description": "FramePort — reliable video downloads and edit-ready conversion",
  "author": "CandyCore",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "electron build/make-icon.js",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "test:language": "node test-language.js",
    "test:updater": "node test-updater.js",
    "test:download-path": "node test-download-path.js",
    "test:download-quality": "electron test-download-quality.js",
    "test:startup": "electron test-startup.js",
    "test:youtube-pot": "electron test-youtube-pot.js"
  },
  "build": {
    "appId": "com.tunarmz.videodownloader",
    "productName": "FramePort",
    "electronLanguages": [
      "en-US",
      "th"
    ],
    "files": [
      "main.js",
      "ytdlp-updater.js",
      "app-updater.js",
      "download-path.js",
      "youtube-pot.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "docs/language.js",
      "fonts/*.woff2",
      "fonts/OFL.txt",
      "build/icon.svg"
    ],
    "extraResources": [
      {
        "from": "vendor/yt-dlp-plugins",
        "to": "yt-dlp-plugins"
      },
      {
        "from": "vendor/licenses",
        "to": "licenses"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "FramePort-mac-${arch}.${ext}"
    },
    "afterPack": "build/list-installed-files.js",
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "FramePort-Setup.${ext}"
    },
    "portable": {
      "artifactName": "FramePort.${ext}"
    },
    "compression": "maximum",
    "publish": [
      {
        "provider": "github",
        "owner": "CandyCoreProj",
        "repo": "FramePort"
      }
    ]
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
