{
  "name": "frameport",
  "productName": "FramePort",
  "version": "1.0.0",
  "description": "FramePort — reliable video downloads and edit-ready conversion",
  "author": "tunarmz",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "electron build/make-icon.js",
    "dist": "electron-builder --win",
    "test:language": "node test-language.js",
    "test:updater": "node test-updater.js",
    "test:download-path": "node test-download-path.js"
  },
  "build": {
    "appId": "com.tunarmz.videodownloader",
    "productName": "FramePort",
    "electronLanguages": [
      "en-US",
      "th"
    ],
    "files": [
      "main.js",
      "ytdlp-updater.js",
      "download-path.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "docs/language.js",
      "build/icon.svg"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "FramePort-Setup.${ext}"
    },
    "portable": {
      "artifactName": "FramePort.${ext}"
    },
    "compression": "maximum"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3"
  }
}
